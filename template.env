# Copy this file to .env and uncomment only the lines you
# need. A missing, commented-out, or empty setting means
# "use the built-in default" (shown in parentheses).
#
# Literary Braille table (default: en-ueb-g2.ctb)
# LIBLOUIS_UEB_TABLE=C:\Liblouis\share\liblouis\tables\en-ueb-g2.ctb
#
# Math Braille table (default: en-ueb-math.ctb)
# LIBLOUIS_UEB_MATH_TABLE=C:\Liblouis\share\liblouis\tables\en-ueb-math.ctb
#
# Full path to lou_translate when it is not on PATH
# LOU_TRANSLATE_CMD=C:\Liblouis\bin\lou_translate.exe
#
# Full path to tesseract.exe when it is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
